<Window x:Class="SaveProfileSwitcher.App.Views.BackupManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Manager" Width="700" Height="450"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderTextBlock" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="Manage rolling ZIP backups for the selected game and profile." Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <ListBox x:Name="BackupsListBox" Grid.Row="1" DisplayMemberPath="ToString" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <CheckBox x:Name="SnapshotCheckBox" Content="Create safety snapshot before restore" Margin="0,0,16,0" IsChecked="True" />
            <Button Content="Restore Selected" Width="140" Click="Restore_Click" />
        </StackPanel>
    </Grid>
</Window>
