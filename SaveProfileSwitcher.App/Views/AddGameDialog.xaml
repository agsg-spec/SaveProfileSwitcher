<Window x:Class="SaveProfileSwitcher.App.Views.AddGameDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add Game" Width="700" Height="760" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}"><ScrollViewer Margin="16"><StackPanel><TextBlock Text="Add Game" FontSize="22" FontWeight="SemiBold"/><GroupBox Header="Game Information" Margin="0,16,0,0"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Label Content="Game name"/><TextBox x:Name="GameNameTextBox" Grid.Column="1" TextChanged="ValidationChanged"/><Label Grid.Row="1" Content="Platform / Emulator"/><ComboBox x:Name="PlatformComboBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="PC"/><ComboBoxItem Content="Goldberg Emulator"/><ComboBoxItem Content="Xenia"/><ComboBoxItem Content="RPCS3"/><ComboBoxItem Content="Cemu"/><ComboBoxItem Content="PCSX2"/><ComboBoxItem Content="Dolphin"/><ComboBoxItem Content="DuckStation"/><ComboBoxItem Content="PPSSPP"/><ComboBoxItem Content="Ryujinx"/><ComboBoxItem Content="Yuzu"/><ComboBoxItem Content="Suyu"/><ComboBoxItem Content="Vita3K"/><ComboBoxItem Content="RetroArch"/><ComboBoxItem Content="MelonDS"/><ComboBoxItem Content="DeSmuME"/><ComboBoxItem Content="Custom Emulator"/></ComboBox><Label Grid.Row="2" Content="Source type"/><ComboBox x:Name="SourceTypeComboBox" Grid.Row="2" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="Standard PC Game"/><ComboBoxItem Content="Emulator Game"/><ComboBoxItem Content="Goldberg/Steam Emulator"/><ComboBoxItem Content="Custom"/></ComboBox><Label Grid.Row="3" Content="Game ID / AppID / Title ID"/><TextBox x:Name="GameIdTextBox" Grid.Row="3" Grid.Column="1" TextChanged="ValidationChanged"/><Label Grid.Row="4" Content="Cover image path"/><TextBox x:Name="CoverImagePathTextBox" Grid.Row="4" Grid.Column="1"/></Grid></GroupBox><GroupBox Header="Executable and save paths" Margin="0,12,0,0"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Label Content="Game or emulator EXE"/><TextBox x:Name="ExecutablePathTextBox" Grid.Column="1" TextChanged="ValidationChanged"/><Label Grid.Row="1" Content="Live save path"/><TextBox x:Name="SaveDirectoryTextBox" Grid.Row="1" Grid.Column="1" TextChanged="ValidationChanged"/><Label Grid.Row="2" Content="Detection status"/><TextBlock x:Name="DetectionStatusTextBlock" Grid.Row="2" Grid.Column="1" Text="Manual path required" Foreground="{StaticResource WarningBrush}"/><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"><Button Content="Browse EXE" Click="BrowseExecutable_Click"/><Button Content="Detect Save Path" Click="DetectSavePath_Click"/><Button Content="Browse Save Folder" Click="BrowseSaveDirectory_Click"/><Button Content="Open Folder" Click="OpenSaveDirectory_Click"/></StackPanel></Grid></GroupBox><GroupBox Header="Save management" Margin="0,12,0,0"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Label Content="Save mode"/><ComboBox x:Name="SaveModeComboBox" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="Inherit Global"/><ComboBoxItem Content="Symbolic Link / Junction"/><ComboBoxItem Content="Physical Move &amp; Swap"/><ComboBoxItem Content="Copy &amp; Overwrite"/></ComboBox><Label Grid.Row="1" Content="Backup retention"/><Slider x:Name="RetentionSlider" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="20" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Choose a mode carefully. Links share the live folder; Move &amp; Swap is safest for incompatible layouts; Copy &amp; Overwrite replaces files and should be backed up first." TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/></Grid></GroupBox><TextBlock Text="Warnings: Symlink/Junction requires appropriate permissions. Steam Cloud or shared emulator folders can overwrite or merge saves. Missing paths must be created or selected manually." TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button x:Name="SaveButton" Content="Save" IsDefault="True" IsEnabled="False" Click="Save_Click"/></StackPanel></StackPanel></ScrollViewer></Window>