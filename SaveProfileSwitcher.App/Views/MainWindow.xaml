<Window x:Class="SaveProfileSwitcher.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SaveProfileSwitcher" Width="1180" Height="760" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SaveProfileSwitcher" FontSize="24" FontWeight="Bold"/><TextBlock Text="Manage multiple save profiles across games and emulators" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="+ Add User Profile" Click="AddProfile_Click"/><Button Content="+ Add Game" Click="AddGame_Click"/><Button Content="⚙ General Settings" Click="Settings_Click"/><Button Content="📁 App Storage" Click="AppStorage_Click"/></StackPanel></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Padding="12" Margin="0,0,12,0" Background="{StaticResource MainPanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"><StackPanel><TextBlock Text="User Profiles" FontSize="18" FontWeight="SemiBold"/><ListBox x:Name="ProfilesListBox" Margin="0,12,0,0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile,Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="GamesListBox" ItemsSource="{Binding Games}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,12" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding GameName}" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="{Binding EmulatorConfig.PlatformName}" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Row="2" Text="{Binding EmulatorConfig.TitleId}" Foreground="{StaticResource SecondaryTextBrush}"/><StackPanel Grid.Row="3" Orientation="Horizontal"><ComboBox x:Name="ProfileSelectorComboBox" Width="180" ItemsSource="{Binding DataContext.Profiles, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="DisplayName"/><Button Content="🎮 Launch" Click="Launch_Click"/><Button Content="🔄 Quick Switch" Click="QuickSwitch_Click" Tag="{Binding ElementName=ProfileSelectorComboBox}"/><Button Content="💾 Backups" Click="Backups_Click"/><Button Content="✏ Edit" Click="EditGame_Click"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Row="1" Padding="12" Background="{StaticResource MainPanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"><StackPanel><TextBlock Text="Selected Game Details" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Live save path" Margin="0,8,0,0"/><TextBlock Text="{Binding SelectedGame.EmulatorConfig.SaveRootPath}" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="Profile archive path" Margin="0,8,0,0"/><TextBlock Text="{Binding SelectedProfile.StorageRootPath}" Foreground="{StaticResource SecondaryTextBrush}"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Transfer Save to another User" Click="TransferSave_Click"/><Button Content="Create Zip Backup" Click="CreateZipBackup_Click"/></StackPanel></StackPanel></Border></Grid></Grid><TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,16,0,0"/></Grid></Window>