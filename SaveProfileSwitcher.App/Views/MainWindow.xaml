<Window x:Class="SaveProfileSwitcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaveProfileSwitcher" Width="1100" Height="600" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="6" Padding="10">
            <DockPanel>
                <TextBlock Text="SaveProfileSwitcher" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Global profile:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" Width="220" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Games" FontSize="16" FontWeight="Bold" />
                    <ListBox Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181820" CornerRadius="4" Padding="10" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding GameName}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding GameId}" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding EmulatorConfig.PlatformName}" Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Save mode" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding DefaultSaveMode}" />
                                            <TextBlock Text="{Binding EmulatorConfig.TitleId}" Margin="0,5,0,0" />
                                            <Button Content="Switch" Command="{Binding DataContext.SwitchProfileForSelectedGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,6,0,0" />
                                            <Button Content="Backups" Command="{Binding DataContext.OpenBackupsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="6" Padding="10" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Selected game" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedGame.GameName}" FontSize="18" Margin="0,10,0,0" />
                    <TextBlock Text="Platform" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding SelectedGame.EmulatorConfig.PlatformName}" />
                    <TextBlock Text="Title ID" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding SelectedGame.EmulatorConfig.TitleId}" />
                    <TextBlock Text="Active global profile" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding SelectedProfile.DisplayName}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
