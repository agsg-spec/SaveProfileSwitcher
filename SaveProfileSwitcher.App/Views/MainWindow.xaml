<Window x:Class="SaveProfileSwitcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaveProfileSwitcher" Width="1200" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}" Padding="10">
            <DockPanel>
                <TextBlock Text="SaveProfileSwitcher" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Active Profile:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource SubtleTextBrush}" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" Width="200" Margin="0,0,10,0" />
                    <Button Content="+ Add User Profile" Click="AddProfile_Click" />
                    <Button Content="+ Add Game" Click="AddGame_Click" />
                    <Button Content="⚙ General Settings" Click="Settings_Click" />
                    <Button Content="📁 App Storage" Click="AppStorage_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Games List -->
            <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Games" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="4" Padding="10" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock Text="{Binding EmulatorConfig.PlatformName}" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding EmulatorConfig.TitleId}" Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="🎮 Launch" Margin="2" />
                                            <Button Content="🔄 Quick Switch" Command="{Binding DataContext.SwitchProfileForSelectedGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="2" />
                                            <Button Content="💾 Backups" Command="{Binding DataContext.OpenBackupsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="2" />
                                            <Button Content="✏ Edit" Margin="2" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Details Panel -->
            <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="6" Padding="10" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Selected Game" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SelectedGame.GameName}" FontSize="20" Margin="0,0,0,10" />
                    <TextBlock Text="Platform" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding SelectedGame.EmulatorConfig.PlatformName}" Margin="0,0,0,8" />
                    <TextBlock Text="Title ID" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding SelectedGame.EmulatorConfig.TitleId}" Margin="0,0,0,8" />
                    <TextBlock Text="Active Profile" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding SelectedProfile.DisplayName}" Margin="0,0,0,12" />
                    <Button Content="Transfer Save to another User" Margin="0,4" />
                    <Button Content="Create Zip Backup" Margin="0,4" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
