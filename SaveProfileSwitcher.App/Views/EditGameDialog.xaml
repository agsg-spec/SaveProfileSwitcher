<Window x:Class="SaveProfileSwitcher.App.Views.EditGameDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Edit Game" Width="640" Height="620" WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Edit Game Configuration" FontSize="20"/><Grid Grid.Row="1" Margin="0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Game Title"/><TextBox x:Name="GameTitleTextBox" Grid.Column="1" TextChanged="RequiredField_TextChanged"/><TextBlock Grid.Row="1" Text="Platform / Emulator"/><ComboBox x:Name="PlatformComboBox" Grid.Row="1" Grid.Column="1"><ComboBoxItem Content="PC"/><ComboBoxItem Content="RPCS3"/><ComboBoxItem Content="Xenia"/><ComboBoxItem Content="Cemu"/><ComboBoxItem Content="PCSX2"/><ComboBoxItem Content="Dolphin"/><ComboBoxItem Content="DuckStation"/><ComboBoxItem Content="Ryujinx"/></ComboBox><TextBlock Grid.Row="2" Text="Title ID / AppID"/><TextBox x:Name="TitleIdTextBox" Grid.Row="2" Grid.Column="1" TextChanged="RequiredField_TextChanged"/><TextBlock Grid.Row="3" Text="Save Directory"/><TextBox x:Name="SaveDirectoryTextBox" Grid.Row="3" Grid.Column="1" TextChanged="RequiredField_TextChanged"/><TextBlock Grid.Row="4" Text="Executable Path"/><TextBox x:Name="ExecutablePathTextBox" Grid.Row="4" Grid.Column="1"/><TextBlock Grid.Row="5" Text="Save Mode"/><ComboBox x:Name="SaveModeComboBox" Grid.Row="5" Grid.Column="1"><ComboBoxItem Content="Symlink / Junction"/><ComboBoxItem Content="Move &amp; Swap"/><ComboBoxItem Content="Copy &amp; Overwrite"/></ComboBox></Grid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click"/><Button x:Name="SaveButton" Content="Save Changes" Margin="8,0,0,0" IsEnabled="False" Click="SaveButton_Click"/></StackPanel></Grid></Window>