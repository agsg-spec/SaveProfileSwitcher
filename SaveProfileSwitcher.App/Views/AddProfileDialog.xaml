<Window x:Class="SaveProfileSwitcher.App.Views.AddProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add User Profile" Width="400" Height="250"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Add New User Profile" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Enter a display name for the new profile." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="Display Name" Foreground="{StaticResource SubtleTextBrush}" />
            <TextBox x:Name="DisplayNameTextBox" Margin="0,4,0,0" Padding="6" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Width="80" />
            <Button Content="Create" IsDefault="True" Width="80" Click="Create_Click" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
