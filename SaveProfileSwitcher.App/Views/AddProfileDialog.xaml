<Window x:Class="SaveProfileSwitcher.App.Views.AddProfileDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add User Profile" Width="460" Height="310" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Add New User Profile" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Each profile receives a permanent GUID storage folder." Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Row="1" Margin="0,16"><TextBlock Text="Display Name"/><TextBox x:Name="DisplayNameTextBox" Margin="0,6,0,0" TextChanged="DisplayNameTextBox_TextChanged"/><TextBlock Text="Optional Avatar Image Path" Margin="0,14,0,0"/><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AvatarPathTextBox" Grid.Column="0"/><Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="BrowseAvatar_Click"/></Grid></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="90" IsCancel="True"/><Button x:Name="CreateButton" Content="Create Profile" Width="120" Margin="8,0,0,0" IsDefault="True" IsEnabled="False" Click="Create_Click"/></StackPanel></Grid></Window>