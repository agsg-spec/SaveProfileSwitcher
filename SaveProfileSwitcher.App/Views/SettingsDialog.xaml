<Window x:Class="SaveProfileSwitcher.App.Views.SettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="520" Height="580" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource AppBackgroundBrush}"><Grid Margin="16" Background="{StaticResource AppBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Application Settings" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/><ScrollViewer Grid.Row="1" Margin="0,16,0,16"><StackPanel><CheckBox x:Name="EnableAutomaticBackupsCheckBox" Content="Enable automatic backups before switching"/><TextBox x:Name="DefaultBackupLocationTextBox"/><CheckBox x:Name="EnableLoggingCheckBox" Content="Enable logging"/><CheckBox x:Name="DarkModeCheckBox" Content="Dark Mode"/></StackPanel></ScrollViewer><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save Settings" Margin="8,0,0,0" Click="SaveSettings_Click"/></StackPanel></Grid></Window>