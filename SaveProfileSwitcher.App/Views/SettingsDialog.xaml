<Window x:Class="SaveProfileSwitcher.App.Views.SettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="General Settings" Width="760" Height="760" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}"><ScrollViewer Margin="16"><StackPanel><TextBlock Text="General Settings" FontSize="22" FontWeight="SemiBold"/><GroupBox Header="Save Management" Margin="0,14,0,0"><StackPanel><ComboBox x:Name="GlobalSaveModeComboBox"><ComboBoxItem Content="Symbolic Link / Junction"/><ComboBoxItem Content="Physical Move &amp; Swap"/><ComboBoxItem Content="Copy &amp; Overwrite"/></ComboBox><CheckBox x:Name="SafetyStagingCheckBox" Content="Safety staging enabled"/><CheckBox x:Name="ConfirmSwitchingCheckBox" Content="Confirm before switching"/><CheckBox x:Name="PreventRunningCheckBox" Content="Prevent switching while the game process is running"/></StackPanel></GroupBox><GroupBox Header="Backups" Margin="0,12,0,0"><StackPanel><CheckBox x:Name="AutomaticBackupsCheckBox" Content="Automatic ZIP backups enabled"/><Slider x:Name="RetentionSlider" Minimum="1" Maximum="20" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Text="Retention is limited to 1–20 backups; default is 3."/><CheckBox x:Name="BackupBeforeSwitchingCheckBox" Content="Backup before switching"/><CheckBox x:Name="BackupBeforeRestoringCheckBox" Content="Backup before restoring"/><CheckBox x:Name="BackupBeforeOverwriteCheckBox" Content="Backup before overwrite"/><TextBox x:Name="BackupPathTextBox"/><StackPanel Orientation="Horizontal"><Button Content="Browse" Click="BrowseBackupPath_Click"/><Button Content="Open Backup Folder" Click="OpenBackupFolder_Click"/></StackPanel></StackPanel></GroupBox><GroupBox Header="Application paths" Margin="0,12,0,0"><StackPanel><TextBox x:Name="ApplicationRootTextBox"/><Button Content="Open Application Root" Click="OpenApplicationRoot_Click"/><TextBox x:Name="ProfilesRootTextBox"/><Button Content="Open Profiles Root" Click="OpenProfilesRoot_Click"/><TextBox x:Name="BackupsRootTextBox"/><Button Content="Open Backups Root" Click="OpenBackupsRoot_Click"/><TextBox x:Name="LogsRootTextBox"/><Button Content="Open Logs Root" Click="OpenLogsRoot_Click"/></StackPanel></GroupBox><GroupBox Header="Emulator detection" Margin="0,12,0,0"><StackPanel><CheckBox x:Name="AutomaticDetectionCheckBox" Content="Enable automatic EXE detection"/><CheckBox x:Name="PortableSearchCheckBox" Content="Search portable emulator folders"/><CheckBox x:Name="AppDataSearchCheckBox" Content="Search AppData and Documents"/><TextBox x:Name="CustomEmulatorPathTextBox"/><Button Content="Browse Custom Emulator EXE" Click="BrowseCustomEmulator_Click"/></StackPanel></GroupBox><GroupBox Header="Safety and diagnostics" Margin="0,12,0,0"><StackPanel><CheckBox x:Name="LoggingCheckBox" Content="Enable logging"/><Button Content="Open Logs Folder" Click="OpenLogsRoot_Click"/><Button Content="Open Current Data File" Click="OpenDataFile_Click"/><Button Content="Export Diagnostic Report" Click="ExportDiagnostics_Click"/><Button Content="Clear Old Logs" Click="ClearOldLogs_Click"/></StackPanel></GroupBox><GroupBox Header="Appearance" Margin="0,12,0,0"><StackPanel><CheckBox x:Name="DarkThemeCheckBox" Content="Dark theme enabled"/><Slider x:Name="TextSizeSlider" Minimum="10" Maximum="24" Value="14" TickFrequency="1" IsSnapToTickEnabled="True"/><CheckBox x:Name="CompactLayoutCheckBox" Content="Compact layout density"/><CheckBox x:Name="ShowGameIdsCheckBox" Content="Show game IDs"/><CheckBox x:Name="ShowSavePathsCheckBox" Content="Show save paths"/></StackPanel></GroupBox><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save Settings" Click="SaveSettings_Click"/></StackPanel></StackPanel></ScrollViewer></Window>