<Window x:Class="SaveProfileSwitcher.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SaveProfileSwitcher" Width="1080" Height="720" Background="{StaticResource AppBackgroundBrush}"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="SaveProfileSwitcher" FontSize="24" FontWeight="Bold"/><TextBlock Text="Manage multiple save profiles across games and emulators"/></StackPanel><Grid Grid.Row="1" Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox x:Name="ProfilesListBox" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile,Mode=TwoWay}"/><ListBox x:Name="GamesListBox" Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame,Mode=TwoWay}"/></Grid><TextBlock Grid.Row="2" Text="{Binding StatusMessage}"/></Grid></Window>